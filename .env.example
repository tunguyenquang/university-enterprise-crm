# ==========================================
# CẤU HÌNH MÔI TRƯỜNG - University Enterprise CRM
# ==========================================
# Sao chép file này thành `.env` và điền giá trị thật.
# TUYỆT ĐỐI KHÔNG commit file `.env` thật lên git.

# --- Server ---
# Cổng chạy server (mặc định 3000 nếu để trống)
PORT=3000
# Môi trường: development | production
NODE_ENV=development

# --- Bảo mật / Authentication ---
# Khóa bí mật ký JWT. BẮT BUỘC đặt chuỗi ngẫu nhiên đủ dài (>= 32 ký tự) ở production.
# Có thể sinh bằng: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="thay-bang-chuoi-ngau-nhien-dai-toi-thieu-32-ky-tu"
# Thời gian sống của token (vd: 1h, 8h, 7d)
JWT_EXPIRES_IN="8h"
# Số vòng băm bcrypt (10-12 là hợp lý)
BCRYPT_ROUNDS=10
# Mật khẩu mặc định cho user seed (CHỈ dùng cho lần khởi tạo dữ liệu mẫu)
SEED_DEFAULT_PASSWORD="Password123!"

# --- CORS ---
# Danh sách origin được phép, phân tách bằng dấu phẩy. Để trống = cho phép same-origin.
# Ví dụ: https://crm.truong.edu.vn,https://admin.truong.edu.vn
CORS_ORIGINS=""

# --- Database ---
# Chọn backend lưu trữ:
#   "json"   -> file data/db.json (mặc định; tiện cho dev/demo, không cần cài DB)
#   "prisma" -> PostgreSQL qua Prisma (khuyến nghị cho production)
DB_BACKEND="json"
# Chỉ cần khi DB_BACKEND="prisma". Sau khi đặt, chạy:
#   npm run db:migrate   (áp dụng schema)
#   npm run db:seed      (nạp dữ liệu mẫu)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/crm?schema=public"

# --- Upload ---
# Thư mục lưu file đính kèm (mặc định ./uploads)
# UPLOAD_DIR="uploads"

# --- AI (tùy chọn, hiện chưa sử dụng) ---
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- App ---
# URL nơi ứng dụng được host (dùng cho link tự tham chiếu)
APP_URL="http://localhost:3000"
