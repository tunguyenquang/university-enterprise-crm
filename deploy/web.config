<?xml version="1.0" encoding="utf-8"?>
<!-- hustcrm.jvs.com.vn - IIS reverse proxy (ARR) -> Node.js app tai 127.0.0.1:3090
     App chay bang Windows Service "hustcrm" (NSSM). Tai lieu day du: deploy/README.md

     BO TRI: site nay o C:\inetpub\wwwroot\hustcrm.jvs.com.vn, code Node nam trong
     thu muc con "app\" (app\dist, app\.env, app\node_modules...). Vi code nam DUOI
     document root nen phai co HAI lop chan de IIS khong bao gio phuc vu file tinh:
       1. Rule rewrite bat TAT CA request (.*) chuyen sang Node -> khong con request
          nao cham tai file tren dia.
       2. requestFiltering chan tuong minh cac duong dan/duoi file nhay cam
          (.env chua JWT_SECRET va mat khau DB, .map lo source, node_modules).
     Lop 2 la de phong truong hop rule rewrite bi tat/loi cau hinh.

     LUU Y QUAN TRONG (da tra gia o site khac tren cung may):
     KHONG dung <serverVariables>: allowedServerVariables o server level dang trong,
     them vao do se anh huong MOI site khac tren .174. URL cong khai cua app lay tu
     bien moi truong APP_URL nen khong can X-Forwarded-Proto. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <!-- Chuyen toan bo request sang Node app, giu nguyen path + query.
             stopProcessing=true => khong co rule nao sau day chay, va IIS khong
             fallback sang static file handler. -->
        <rule name="ReverseProxyToNode" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://127.0.0.1:3090/{R:1}" />
        </rule>
      </rules>
      <outboundRules>
        <!-- Sua Location header cua redirect: http://127.0.0.1:3090 -> https://hustcrm.jvs.com.vn -->
        <rule name="RewriteLocationHeader" preCondition="IsRedirect">
          <match serverVariable="RESPONSE_Location" pattern="^http://127\.0\.0\.1:3090/(.*)" />
          <action type="Rewrite" value="https://hustcrm.jvs.com.vn/{R:1}" />
        </rule>
        <preConditions>
          <preCondition name="IsRedirect">
            <add input="{RESPONSE_STATUS}" pattern="3[0-9][0-9]" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>

    <security>
      <requestFiltering>
        <!-- Upload file dinh kem MOU: cho phep file lon (mac dinh IIS chi 30MB) -->
        <requestLimits maxAllowedContentLength="104857600" />
        <!-- Lop chan thu hai: khong bao gio tra ve file/thu muc nhay cam cua app -->
        <hiddenSegments>
          <add segment="app" />
          <add segment="node_modules" />
          <add segment="logs" />
          <add segment="prisma" />
        </hiddenSegments>
        <fileExtensions>
          <add fileExtension=".env" allowed="false" />
          <add fileExtension=".map" allowed="false" />
          <add fileExtension=".ps1" allowed="false" />
          <add fileExtension=".cjs" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- Khong liet ke noi dung thu muc trong moi truong hop -->
    <directoryBrowse enabled="false" />
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
